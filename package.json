{
  "name": "@flowingspring/dsh-voco",
  "description": "Persistent voice conversations for DSH with cloud speech recognition, Edge TTS, and background Agent delegation",
  "version": "0.3.12",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "voice",
    "speech-recognition",
    "text-to-speech",
    "agent"
  ],
  "homepage": "https://github.com/lgquan/dsh-voco#readme",
  "bugs": {
    "url": "https://github.com/lgquan/dsh-voco/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgquan/dsh-voco.git"
  },
  "type": "module",
  "main": "packages/voice-app/lib/index.js",
  "types": "packages/voice-app/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/voice-app/lib/types/index.d.ts",
      "default": "./packages/voice-app/lib/index.js"
    },
    "./client": {
      "default": "./packages/voice-app/lib/client.js"
    },
    "./invariant": {
      "types": "./packages/voice-app/lib/types/invariant.d.ts",
      "default": "./packages/voice-app/lib/invariant.js"
    },
    "./llm-tool-call-compat": "./packages/voice-app/lib/plugins/llm-tool-call-compat.js",
    "./voice": "./packages/voice-app/lib/plugins/voice.js",
    "./voice-local": "./packages/voice-app/lib/plugins/voice-local.js",
    "./voice-assistant": "./packages/voice-app/lib/plugins/voice-assistant.js",
    "./voice-web": "./packages/voice-app/lib/plugins/voice-web.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --dir packages/voice-app exec tsdown",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "files": [
    "cordis.patch.yml",
    "packages/voice-app/lib/index.js",
    "packages/voice-app/lib/invariant.js",
    "packages/voice-app/lib/client.js",
    "packages/voice-app/lib/client.js.map",
    "packages/voice-app/lib/plugins/*.js",
    "packages/voice-app/lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "node-edge-tts": "1.2.10",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
