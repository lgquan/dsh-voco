{
  "name": "@lgquan/dsh-voice-local",
  "description": "Cross-platform local ONNX VAD, ASR, and MOSS-TTS provider for dsh-voice",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "OPENMOSS-LICENSE"
  ],
  "license": "MIT AND Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1",
    "@lgquan/dsh-voice": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@sctg/sentencepiece-js": "1.3.3",
    "onnxruntime-node": "1.29.0",
    "sherpa-onnx-node": "1.13.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1",
    "@lgquan/dsh-voice": "workspace:*"
  }
}
